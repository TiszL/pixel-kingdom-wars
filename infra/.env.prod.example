# Production environment for infra/docker-compose.prod.yml — the one VPS.
#   cp infra/.env.prod.example infra/.env.prod   and fill it in ON THE SERVER.
# .env.prod is gitignored and must stay that way.
#
# KEYPAIR PATH RULE — paths are CONTAINER paths. The compose file mounts
# ./infra/keys → /app/infra/keys read-only, so every *_KEYPAIR_PATH below must
# start with /app/infra/keys/. A host path (~/.config/solana/..., /Users/...)
# crash-loops the worker with ENOENT — the container cannot see the host's
# filesystem (hit exactly this on 2026-08-03, see docker-compose.local.yml).
#
# infra/keys/ on this box must contain all three of:
#   admin.keypair.json      — copy of the ops machine's ~/.config/solana/id.json
#                             (it is NOT named that in infra/keys by default)
#   hot-wallet.keypair.json — funded payout wallet
#   deed-ops.keypair.json   — deed URI update signer

# --- the box ---------------------------------------------------------------
# THE ONE PUBLIC ORIGIN: Caddy serves the game dist AND proxies /api here.
# The DNS A record starts DNS-ONLY (grey cloud) so Caddy's ACME challenge can
# reach the box; the Caddyfile already handles a later flip to CF-proxied.
API_DOMAIN=play.pixelkingdomwars.com
API_IMAGE=shardkeep-api:latest

# --- postgres --------------------------------------------------------------
POSTGRES_USER=shardkeep
# openssl rand -base64 32
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=shardkeep

# Runtime database isolation. `legacy` preserves existing devnet deployments;
# `isolated` provisions two non-owner logins on this SAME Postgres instance.
# mainnet-beta refuses to start in legacy mode. Generate URL-safe hex values so
# Compose can place them in DATABASE_URL without percent-encoding ambiguity:
#   openssl rand -hex 32
DB_ROLE_MODE=isolated
API_DB_USER=shardkeep_api
API_DB_PASSWORD=CHANGEME_API_HEX_64_CHARACTERS
WORKER_DB_USER=shardkeep_worker
WORKER_DB_PASSWORD=CHANGEME_WORKER_HEX_64_CHARACTERS

# --- api core --------------------------------------------------------------
# Credentialed CORS allowlist, exact string match, no trailing slash. Under the
# single origin CORS is never consulted by browsers, but keep it honest.
# PLAY_URL falls back to WEB_ORIGIN[0] — if more entries are ever appended,
# play.* must stay FIRST or invite emails start linking somewhere else.
WEB_ORIGIN=https://play.pixelkingdomwars.com
# openssl rand -base64 48
JWT_SECRET=CHANGEME_AT_LEAST_32_CHARS

# NODE_ENV defaults to production in config.ts (fail-closed: an unset value must
# never mean development, or the signature-less dev-login route opens).

# Marketing-site origins allowed to reach ONLY /alpha/apply, without
# credentials. Defaults to https://pixelkingdomwars.com,https://www.pixelkingdomwars.com
# in config.ts — only set this to CHANGE that list.
#LANDING_ORIGINS=

# Where invite emails send players. Optional — falls back to WEB_ORIGIN[0].
# The native update channel also builds apkUrl from PLAY_URL ?? WEB_ORIGIN[0].
PLAY_URL=https://play.pixelkingdomwars.com

# --- solana ----------------------------------------------------------------
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_SERVER_HELIUS_KEY
# Optional dedicated source for ALL mint inventory/original/close proofs.
# Unset uses the primary. Production rejects shared public RPC endpoints.
MINT_EVIDENCE_RPC_URL=
# Required for the credential-free browser build and its serving gate.
RPC_RELAY_ENABLED=true
# Optional for devnet; mandatory for mainnet-beta. Mainnet also requires two
# different non-secret vendor labels so different hostnames from one provider
# cannot be mistaken for failure independence. Both endpoints are genesis-
# checked before the application opens the database.
SOLANA_RPC_URL_2=
SOLANA_RPC_PROVIDER=
SOLANA_RPC_PROVIDER_2=
# Read-only mainnet, ONLY for Seeker SGT + .skr verification. Two INDEPENDENT
# providers: a badge is granted only when both agree. Unset ⇒ every verdict is
# reported `unconfirmed` rather than guessed.
# CARRY-OVER NOTE: on the Mac these values (and HELIUS_API_KEY) live ONLY in
# the gitignored generated infra/docker-compose.origin.yml — copy them from
# there by hand; nothing in git holds them.
SOLANA_MAINNET_RPC_URL=
SOLANA_MAINNET_RPC_URL_2=
# Helius DAS reads for the marketplace's owned-NFT list. Unset ⇒ /market
# degrades to external links + an empty asset list.
HELIUS_API_KEY=

# --- keys (CONTAINER paths — see the header) --------------------------------
# Admin signer: post_root relay + deed mint authority.
ADMIN_KEYPAIR_PATH=/app/infra/keys/admin.keypair.json
# Incident-only exact epoch-root recovery map. Leave empty normally. The worker
# accepts a supplied transaction only when its successful post_root bytes and
# canonical config/root/system accounts match the pending row. See the runbook.
EPOCH_ROOT_RECOVERY_SIGNATURES=
# Funded hot wallet for KEEP custody. Only the private withdrawal-signer service
# receives this file; the database-connected worker and public API receive the
# public key only. The compose service pins this container path explicitly.
# Keep the legacy container path in the host env for rollback compatibility.
# Current compose overrides signer to /run/secrets and clears it on worker/API.
HOT_WALLET_KEYPAIR_PATH=/app/infra/keys/hot-wallet.keypair.json
# PUBLIC address of the key above. Safe for API/worker reserve and deposit reads.
HOT_WALLET_PUBKEY=
# Independent signing policy. Generate the worker-only token once with:
#   umask 077; openssl rand -base64 48 | tr '+/' '-_' | tr -d '=\n' > infra/keys/withdrawal-policy-signer.token
# Then initialize the durable empty state ONCE (never after it has signed):
#   ./infra/init-policy-signer-state.sh --confirm-empty-state
# Numeric owner of every signer key/token/state file on the host. The production
# deploy account and the official Node image both use 1000:1000. If a replacement
# host differs, set these deliberately before initializing state; deploy fails
# closed on any ownership mismatch.
WITHDRAWAL_POLICY_SIGNER_UID=1000
WITHDRAWAL_POLICY_SIGNER_GID=1000
WITHDRAWAL_SIGNER_MODE=remote
# `remote` isolates the database worker; it does not turn this software key into
# hardware custody. This image implements only `file`, which is devnet-only and
# deliberately blocks mainnet-beta until a reviewed HSM/enclave adapter exists.
WITHDRAWAL_POLICY_CUSTODY_BACKEND=file
WITHDRAWAL_POLICY_SIGNER_URL=http://withdrawal-signer:3003
# Fail closed outside the reviewed compose topology; compose grants this only
# after pinning the exact internal origin/network itself.
WITHDRAWAL_POLICY_SIGNER_ALLOW_PRIVATE_HTTP=false
WITHDRAWAL_POLICY_SIGNER_AUTH_TOKEN_FILE=/run/secrets/withdrawal-policy-signer.token
# Must equal the reviewed selected-cluster KEEP mint in infra/*.addresses.json.
WITHDRAWAL_POLICY_KEEP_MINT=
# Independent custody ceilings (whole KEEP). These are operator risk controls,
# not player-facing shared allowance. transfer <= wallet <= aggregate.
WITHDRAWAL_POLICY_MAX_PER_TRANSFER_KEEP=
WITHDRAWAL_POLICY_MAX_PER_WALLET_24H_KEEP=
WITHDRAWAL_POLICY_MAX_AGGREGATE_24H_KEEP=
# Worker operational cadences. 10s keeps 2FA-authorized "instant" payouts
# prompt without any in-request signing; deed reconciliation is bounded/pass.
WITHDRAWAL_PAYOUT_POLL_MS=10000
DEED_MINT_RECONCILE_POLL_MS=60000
# Signer for on-chain deed URI updates (the deed-chain sweep in the worker).
DEED_OPS_KEYPAIR_PATH=/app/infra/keys/deed-ops.keypair.json

# --- deeds ------------------------------------------------------------------
# Opt-in: the worker's on-chain URI sweep SPENDS SOL from the deed-ops key.
# Unset ⇒ the sweep does not run and /health reports the leg as not-running-ok.
DEED_CHAIN_SYNC=true

# R2 bucket hosting deed metadata and public wallet avatars. WITHOUT THESE,
# DEEDS ARE NEVER MINTED and avatar uploads answer 503:
# jobs.ts refuses to mint without a public metadata host and logs
# "[deed] minting DISABLED", which froze deed metadata for five days once.
# The API writes request-time `avatar/` objects; the worker reconciles `deed/`.
# Each code path has its own exact key guard. Use the SAME bucket the existing
# deed tooling uses; the backup bucket is separate and must stay separate.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Where deed royalties are paid. Empty = the admin signer (devnet status quo).
# Setting it does NOT move the royalty by itself — run the ops sweep:
#   DEED_ROYALTY_CREATOR=<addr> pnpm --filter @shardkeep/scripts deed:royalty:creator --confirm
DEED_ROYALTY_CREATOR=

# --- access control ----------------------------------------------------------
# An admitted player receives a limited base for free but NO parcel/world row.
# The 0.2 SOL purchase later stamps land ownership, assigns the parcel, mints the
# deed receipt and unlocks the paid feature set. Keep this explicit: the API's
# code default is deliberately false as a rollback switch.
FREE_ONBOARDING=true
# Deed metadata already carries the irreversible Country + Tile traits. This is
# production API config, not a future rollout switch.
DEED_LOCATION_V2=true
# Deed-native multi-base is permanently active after the one-way writer cutover.
# A ready production database rejects false at startup.
MULTI_BASE_ENABLED=true
# Stage the dual-address release with native sales disabled, then apply the
# reviewed fantasy manifest before enabling. False still recovers existing
# payments and publishes already-assigned deeds; it is not a publisher switch.
FANTASY_WORLD_ENABLED=false
# D-151: read-only Phase E policy catalogue for authenticated players.
# This does not activate gameplay, taxes, permits, claims or native capabilities.
# Keep false until separately approved for activation.
PHASE_E_CATALOG_ENABLED=false
# Lost PKW-authenticator recovery is a two-phase custody rollout. Deploy and
# verify the migration plus every API/worker container with this false first;
# then set true in a separate activation. Once any recovery reaches `holding`,
# an old image does not understand the hold/latch and is NOT a safe rollback —
# keep the database and fix forward.
TOTP_RECOVERY_ENABLED=false
# Token login is dark until the real Privy account acceptance passes.
SOCIAL_TOKEN_LOGIN_ENABLED=false
PRIVY_APP_ID=
# https://auth.privy.io/api/v1/apps/<app-id>/jwks.json
PRIVY_JWKS_URL=
# Ranked rewards ship dark. Enable only before a complete Monday-to-Monday
# earning window begins; never enable mid-window or backfill a partial week.
LEAGUE_REWARDS_ENABLED=false
# Monday UTC. Advance to the next Monday if rollout misses this full window.
LEAGUE_REWARD_START_WEEK=2026-09-07
# Devnet only: show the labelled TEST weekly SKR season pot on the read-only
# GET /leagues/season. Off by default; never set on mainnet. Not the owner's number.
LEAGUE_SEASON_TEST_POT_ENABLED=false
# M22 private mail. false blocks only NEW deliveries; inbox reads, reward claims,
# and expiry/unwind remain live so escrow can drain. Enabling is a forward-only
# custody boundary: follow docs/DEPLOYMENT.md before any rollback.
MAIL_DELIVERY_ENABLED=false
# Mainnet admin KEEP mail is a separately reviewed, cumulative-budget campaign.
# Leave disabled unless all three values are intentionally provisioned.
MAINNET_COMMUNITY_KEEP_MAIL_ENABLED=false
MAINNET_COMMUNITY_KEEP_MAIL_CAMPAIGN_ID=
MAINNET_COMMUNITY_KEEP_MAIL_BUDGET=

# Explicit open playtest, independent of internal wallet exclusions.
# Set true after verified release to admit every authenticated player without a code.
# Keep ALPHA_WALLETS intact: it also excludes internal wallets from public analytics.
PLAYTEST_OPEN=false

# Internal/legacy admission wallet list. Do not erase it to open the playtest.
ALPHA_WALLETS=

# Admin wallets for the alpha review panel. UNSET ⇒ every /admin/alpha route
# answers 404, even authenticated — the panel simply does not exist, and no
# invite can ever be approved. Same base58 validation posture as ALPHA_WALLETS.
ADMIN_WALLETS=

# Cloudflare Turnstile SERVER secret for the public POST /alpha/apply form.
# Unset ⇒ applications are accepted WITHOUT bot verification (loud boot warning)
# — acceptable in dev, a spam magnet on a public domain.
TURNSTILE_SECRET_KEY=

# Resend (resend.com) key + verified sender ("Name <email>" or bare address).
# BOTH are required in production; missing or half-configured email fails boot.
# DOUBLE-QUOTE the display-name form: this file is also `source`d by
# infra/backup/{backup,verify-restore}.sh, where an unquoted
#   EMAIL_FROM=Pixel Kingdom Wars <noreply@...>
# is a shell parse error (`<` becomes a redirect) that kills every deploy at
# the pre-migration backup. Compose strips the quotes, so both readers agree:
#   EMAIL_FROM="Pixel Kingdom Wars <noreply@pixelkingdomwars.com>"
RESEND_API_KEY=
EMAIL_FROM=
# Web Push notifications (M33, D-101). OFF until the VAPID trio is on the box;
# deploy.sh refuses PUSH_NOTIFICATIONS_ENABLED=true unless all three are set.
# generate once with npx web-push generate-vapid-keys; never rotate casually —
# rotating invalidates every stored subscription.
#   VAPID_SUBJECT=mailto:support@pixelkingdomwars.com
PUSH_NOTIFICATIONS_ENABLED=false
# Separate fail-closed rollout for the Mine-full source. Requires push above.
MINE_FULL_NOTIFICATIONS_ENABLED=false
# Enable only after the post-migration 1x production smoke. Existing V2 rows
# remain readable/resolvable while false, and may safely transition 2x -> 1x.
LIVE_RAID_V2_ENABLED=false
# Independent selected-base raid alert rollout; false retains client status polling.
RAID_EVENTS_ENABLED=false
# Additive native presentation. Do not enable before capacity/device acceptance.
NATIVE_PRESENTATION_ENABLED=false
# Optional on the ordinary API; required when the separate companion is enabled.
# Comma-separated tester public wallets. Empty must never publish the companion.
NATIVE_PRESENTATION_WALLETS=
# Ordinary API only. Enabling native presentation without a tester list refuses
# to boot unless this explicit public switch is true. Never set on the companion.
NATIVE_PRESENTATION_OPEN=false
# Set true ONLY for apps/api/src/native/server.ts, not the existing API/worker.
# The companion uses session/alpha config plus DB/Redis; no email/signing keys.
NATIVE_PRESENTATION_SERVICE=false
NATIVE_DB_POOL_MAX=2
NATIVE_PRESENTATION_WORKERS=1
NATIVE_PRESENTATION_MAX_RAIDS=8
NATIVE_PRESENTATION_MAX_STREAMS=16
NATIVE_PRESENTATION_CACHE_MIB=32
NATIVE_MIN_VERSION_CODE=0
NATIVE_CONTENT_MANIFEST_URL=
# Manifest for renderer contract < 15 (code 25) and web; empty = everyone gets the one above.
# Cutover: copy today's NATIVE_CONTENT_MANIFEST_URL here, then point the one above at the new pack.
NATIVE_CONTENT_MANIFEST_URL_LEGACY=
# Realm environment kit preview (docs/REALM-KIT-PLAN.md, D-173): comma list of realm
# ids this host stamps at groundRevision 5. KEEP EMPTY in production: it overrides
# accepted.json and the catalogue pin, and a native client declaring renderer
# contract 15 (code 26) is then sent revision 5, which its pack cannot draw.
REALM_KIT_PREVIEW_REALMS=
# M45 in-app update channel: dark by default. When true the API advertises channel rows
# from native_update_channel; APK bytes are served by Caddy from R2, never by the API.
NATIVE_UPDATE_CHANNEL_ENABLED=false
# Kill switch for the native new world (globe + realm maps bundled in the APK), default on.
# Set false to send every native client back to the legacy globe on its next capabilities
# read; only the api container needs recreating (docs/NATIVE_PRODUCTION.md).
NATIVE_WORLD_V2_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# REQUIRED in production. First key writes; listed older keys remain read-only
# until lazy TOTP rewrap is complete. Never reuse JWT_SECRET.
# Generate: openssl rand -base64 32
# Format: 2026-08:<base64-key>[,older-id:<base64-key>]
TWOFA_ENCRYPTION_KEYS=

# --- ops knobs -------------------------------------------------------------
# ENABLE_WORKERS is set PER SERVICE in docker-compose.prod.yml (false on api,
# true on the single worker) — do not set it here, or every api replica would
# become a second scheduler.
#
# Postgres connections per container. The withdrawal path takes a GLOBAL advisory
# lock for its whole transaction, so concurrent requests queue while holding a
# connection; 10 is tight once anything else is running.
DB_POOL_MAX=30
# A rollback to an image predating the policy signer MUST first set this false,
# preserve signer state, and reconcile every signed artifact on chain. Never
# run a signerless legacy worker while withdrawals remain enabled.
WITHDRAWALS_ENABLED=true
# Authored dark attackers are enabled in the current SIM9 release.
DARK_ATTACKER_ROSTER_ENABLED=true
# Default-off balance gate; inventory/equip do not depend on this switch.
HERO_GEAR_COMBAT_ENABLED=false
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Gold Forge kill switch. RAW env read (game/routes.ts), NOT schema-validated:
# ONLY the literal lowercase string 'false' disables it — FALSE/0/no silently
# leave it ON. Leave unset for on.
#FORGE_ENABLED=

# --- leave these UNSET in production ----------------------------------------
# PAYOUT_COVERAGE_OVERRIDE  — one-shot manual override of the PoR payout brake.
# DEED_CHAIN_REURI          — one-shot ops toggle to force deed URI rewrites.
# RUN_MIGRATIONS_ON_BOOT    — deploy.sh runs migrations as its own step instead.
# DEV_LOGIN                 — signature-less login; double-gated but never set it.
# DEV_LOGIN_REALM           — dev realm switch for the dev-login base; boot REFUSES it here.
# REALM_KIT_PREVIEW_MANIFESTS — DEV/QA unpinned realm-kit manifests; boot REFUSES it here.

# --- web build ---------------------------------------------------------------
# VITE_PRIVY_* and the browser-safe VITE_SOLANA_RPC_URL are BUILD-time public
# values read from the REPO-ROOT .env (vite envDir). deploy.sh fails if either
# required value is absent and verifies the browser RPC's genesis. It then
# overrides VITE_SOLANA_CLUSTER plus mint/program/Config/treasury addresses from
# this file's SOLANA_CLUSTER and the matching reviewed infra/*.addresses.json;
# those economic identities cannot drift between the API and browser build.
# VITE_SOLANA_RPC_URL must be https://play.pixelkingdomwars.com/api/rpc/solana/devnet
# (use the selected cluster). This route serves wallet-adapter and Privy HTTP/WS.
# Never put provider credentials in browser configuration. Historical immutable
# bundles retain their earlier public key until a separate rotation is planned.
# VITE_REALM_KIT_PREVIEW_MANIFESTS is a web dev-only realm-kit preview map; a
# production build ignores it (import.meta.env.DEV is false). Leave it unset.

# --- backups (target after K-021: hourly from host cron) --------------------
# Where dumps land on the box, and how long local copies are kept.
BACKUP_DIR=/var/backups/shardkeep
BACKUP_KEEP_LOCAL_HOURS=48
# This is an explicit operations classification, independent of NODE_ENV.
# mainnet/mainnet-beta cannot opt out of verified off-host copies. The current
# devnet deployment should keep them required after provisioning. The audited
# live devnet host remains temporarily local-only under K-021; local rehearsals
# may set BACKUP_NETWORK=local and BACKUP_OFFSITE_REQUIRED=false.
BACKUP_NETWORK=devnet
BACKUP_OFFSITE_REQUIRED=true
# Mainnet requires this true and the configured remote to be an rclone crypt
# wrapper, so DB + signer-state artifacts are encrypted before leaving host.
BACKUP_OFFSITE_ENCRYPTED=false
# Weekly drills must restore bytes downloaded from the off-host destination.
BACKUP_VERIFY_SOURCE=remote
# Off-box destination. MUST use its own R2 credentials with their own token —
# never the API's, which holds read+write on the whole deed bucket and would let
# the very compromise you are recovering from delete the backups too.
# Remote retention belongs to a bucket lifecycle rule, not to this box. The
# config file is provisioned on the host with mode 0600 and is never committed.
# As the deploy user: configure a private s3 backend, then an rclone `crypt`
# wrapper over it. Mainnet BACKUP_RCLONE_REMOTE must name that crypt wrapper.
# BACKUP_RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_CONFIG=

# Analytics relays (M23 a13) — optional; unset keeps /telemetry a validated no-op.
POSTHOG_API_KEY=
POSTHOG_HOST=
SENTRY_DSN=

# DEVNET PLAYTEST ONLY — in-game devnet SOL faucet. Worker pays from
# ./keys/devnet-faucet.keypair.json (mounted read-only into the worker).
DEVNET_FAUCET_ENABLED=true

# Native ABI3/7 energy quotes; also requires BASE_PURCHASE_V1_ENABLED=true.
# Keep false until migration0131 and compatible API/worker are verified. Historical recovery remains available.
ENERGY_PURCHASE_V1_ENABLED=false

# --- Native client v1 command families (owner incident 2026-09-18) ------------------------
# The Android app probes each family before offering the action and refuses when the server
# answers enabled=false. WALL_BATCH_V1_ENABLED was never added to production when its siblings
# were (0.5.0, 2026-09-17), so nobody could place walls from the app until the owner noticed.
# Every *_ENABLED flag the API reads must be listed in this file (scripts/src/env-flags.test.ts).
# "false" pauses NEW requests only; history and recovery stay available.
# Native versioned SOL base-purchase quotes.
BASE_PURCHASE_V1_ENABLED=false
# Native ordinary/Warzone shield quotes; also require BASE_PURCHASE_V1_ENABLED=true.
SHIELD_PURCHASE_V1_ENABLED=false
# Exact transferred-deed claim commands.
BASE_CLAIM_V1_ENABLED=false
# Hero recruitment v1 receipts (migration 0126).
HERO_RECRUITMENT_ENABLED=false
# Exact wall-stroke receipts (no migration). Devnet production runs true since 2026-09-18.
WALL_BATCH_V1_ENABLED=false
# Treasury buy-KEEP vend. Fail-closed default; devnet production runs true (owner 2026-08-16).
KEEP_VEND_ENABLED=false
GEMS_ENABLED=false
GEMS_WALLET_BUY_ENABLED=false
DEVNET_WELCOME_GEMS_ENABLED=false
PHASE_E_BUILDINGS_ENABLED=false
PHASE_E_ART_ENABLED=false
FORGE_INGOTS_ENABLED=false
PHASE_E_MINING_ENABLED=false
PHASE_E_SEEKER_ENABLED=false
PHASE_E_VEHICLES_ENABLED=false
PHASE_E_CHARTER_ENABLED=false
ORDINARY_CRAFTING_ENABLED=false
STARTER_EXPEDITIONS_ENABLED=false
HARVESTERS_ENABLED=false

# Phase E D153.190: KEEP equipment listing/purchase admission; default off.
KEEP_EQUIPMENT_MARKET_ENABLED=false

# Phase E public mining PoR: leave all pins blank until separately admitted.
# Read-only disclosure; does not enable publication, claims or custodial backing.
# Hash covers the ENTIRE reviewed ProgramData account (metadata included).
MINING_TRANSPARENCY_PROGRAM_ID=
MINING_TRANSPARENCY_DEPLOYMENT_SLOT=
MINING_TRANSPARENCY_PROGRAM_DATA_SHA256=
# Separate reviewed claim quote/same-wire relay identity; PoR does not enable sends.
# Blank keeps live claim sources absent; original database recovery remains available.
MINING_CLAIM_PROGRAM_ID=
MINING_CLAIM_DEPLOYMENT_SLOT=
MINING_CLAIM_PROGRAM_DATA_SHA256=

# Complete independent realm-sale quote/same-wire relay policy; leave all blank until reviewed.
# Auction mint/prize owner are Seeker auction identities, not KEEP reserve identities.
# UPGRADE_AUTHORITY is the reviewed key or explicit none; ROUND is exact unsigned decimal.
# STATE_PROVENANCE must be the explicit attestation fresh-reviewed-deployment.
SEEKER_REALM_SALE_PROGRAM_ID=
SEEKER_REALM_SALE_DEPLOYMENT_SLOT=
SEEKER_REALM_SALE_PROGRAM_DATA_SHA256=
SEEKER_REALM_SALE_UPGRADE_AUTHORITY=
SEEKER_REALM_SALE_AUCTION_MINT=
SEEKER_REALM_SALE_PRIZE_OWNER=
SEEKER_REALM_SALE_DEVELOPER=
SEEKER_REALM_SALE_ROUND=
SEEKER_REALM_SALE_POLICY_REVISION=
SEEKER_REALM_SALE_STATE_PROVENANCE=

# Private Phase E services: same DB, separate owner LOGIN; leave unset until admitted.
# Never reuse DATABASE_URL or give the request role private journal access.
# Recovery remains mounted while admission flags are paused. No issuer/chain authority implied.
PHASE_E_SERVICE_DATABASE_URL=

# Optional historical KEEP tax quote/relay policy, independent from claims and realm sales.
# Set every field together after review; reserve/mint use the selected economy binding.
# UPGRADE_AUTHORITY is the reviewed key or literal none (revoked). Auction mint is independent of KEEP.
# STATE_PROVENANCE must explicitly be fresh-reviewed-deployment. Round is verified from the original claim.
MINING_TAX_PROGRAM_ID=
MINING_TAX_DEPLOYMENT_SLOT=
MINING_TAX_PROGRAM_DATA_SHA256=
MINING_TAX_UPGRADE_AUTHORITY=
MINING_TAX_AUCTION_MINT=
MINING_TAX_PRIZE_OWNER=
MINING_TAX_STATE_PROVENANCE=

# Optional reviewed Metaplex Core vehicle sources; blank means offline history only.
# Complete pins including upgrade authority key or 'none'; no automatic activation.
VEHICLE_CORE_DEPLOYMENT_SLOT=
VEHICLE_CORE_PROGRAM_DATA_SHA256=
VEHICLE_CORE_UPGRADE_AUTHORITY=

# Phase E read-only Charter original recovery. All blank disables chain reads.
# Explicit reviewed pins never grant permit issuance, new funding or delivery.
CHARTER_RECOVERY_ECONOMY_PROGRAM_ID=
CHARTER_RECOVERY_ECONOMY_DEPLOYMENT_SLOT=
CHARTER_RECOVERY_ECONOMY_PROGRAM_DATA_SHA256=
CHARTER_RECOVERY_ECONOMY_UPGRADE_AUTHORITY=
CHARTER_RECOVERY_CRAFT_PROGRAM_ID=
CHARTER_RECOVERY_CRAFT_DEPLOYMENT_SLOT=
CHARTER_RECOVERY_CRAFT_PROGRAM_DATA_SHA256=
CHARTER_RECOVERY_CRAFT_UPGRADE_AUTHORITY=
CHARTER_RECOVERY_CORE_DEPLOYMENT_SLOT=
CHARTER_RECOVERY_CORE_PROGRAM_DATA_SHA256=
CHARTER_RECOVERY_CORE_UPGRADE_AUTHORITY=
CHARTER_RECOVERY_STATE_PROVENANCE=

# Explicit operator sponsor; no event is funded by mounting this service.
# Requires complete MINING_CLAIM trust. New fragment earnings also need Seeker trust.
DIVINE_TRIAL_SPONSOR_WALLET=

# KEEP market payment sources: complete reviewed limits plus SOLANA_RPC_URL_2 and
# distinct SOLANA_RPC_PROVIDER / SOLANA_RPC_PROVIDER_2 labels. No default spending cap.
# Optional separate broadcast endpoint relays only the player's retained original wire.
KEEP_MARKET_MIN_CONTEXT_SLOT=
KEEP_MARKET_TRANSACTION_VERSION=
KEEP_MARKET_MAX_FEE_LAMPORTS=
KEEP_MARKET_MAX_PRIORITY_FEE_LAMPORTS=
KEEP_MARKET_MAX_COMPUTE_UNIT_LIMIT=
KEEP_MARKET_BROADCAST_RPC_URL=

# Independent clan-event funding identity. Requires complete Charter recovery and
# Seeker policy groups; never initializes an epoch or funds during startup.
# Independent API client to the dedicated Charter issuer. Never a raw private key.
# Issuer-only permits saved original lookup; current actions need the entire next group.
CHARTER_POLICY_ISSUER_URL=
CHARTER_POLICY_ISSUER_PUBLIC_KEY=
CHARTER_POLICY_ISSUER_AUTH_TOKEN_FILE=
CHARTER_POLICY_ISSUER_ALLOW_PRIVATE_HTTP=false
# Explicit full current Charter authority; requires reviewed CHARTER_RECOVERY pins.
# Cost profile is an operator attestation tied to those exact reviewed Core bytes.
CHARTER_WORKFLOW_METADATA_URI_PREFIX=
CHARTER_WORKFLOW_SALE_TREASURY=
CHARTER_WORKFLOW_LOOKUP_TABLE_ADDRESS=
CHARTER_WORKFLOW_LOOKUP_TABLE_SHA256=
CHARTER_WORKFLOW_CORE_COST_PROFILE=
CHARTER_WORKFLOW_MAX_NETWORK_FEE_LAMPORTS=
CHARTER_WORKFLOW_MAX_RENT_LAMPORTS=
CHARTER_WORKFLOW_MAX_TOTAL_LAMPORTS=
CHARTER_WORKFLOW_MAX_ADDITIONAL_LAMPORTS=
# Optional separate exact-original-wire relay. Blank does not send.
CHARTER_WORKFLOW_RELAY_RPC_URL=
CHARTER_TOURNAMENT_SPONSOR_WALLET=
CHARTER_TOURNAMENT_TREASURY=

# DEVNET ONLY (D153.275): leave every DEVNET_SKR_FAUCET_* unset on mainnet-beta; boot refuses any presence.
# Off = no DEVNET_SKR_FAUCET_* line at all (absence means no import, routes or worker). To turn it on, first
# copy the key to the host (docs/deploy/SKR-FAUCET-WORKER-KEY.md), then uncomment the whole group as plain
# KEY=value lines. With =true, deploy.sh refuses the release before maintenance unless
# infra/keys/devnet-skr-faucet.keypair.json is a regular file, mode 0600, owned by
# WITHDRAWAL_POLICY_SIGNER_UID:GID, and the path line below is exactly as written.
# [owner] exact literal true or false, at most once.
# DEVNET_SKR_FAUCET_ENABLED=false
# [owner secret] names the faucet key: the worker's read-only mount of infra/keys/devnet-skr-faucet.keypair.json
# (infra/docker-compose.prod.yml). Keep this exact container path; the api never mounts the file.
# DEVNET_SKR_FAUCET_KEYPAIR_PATH=/run/secrets/devnet-skr-faucet.json
# [owner] Public key of that same keypair (`solana-keygen pubkey`); the worker refuses any other key.
# DEVNET_SKR_FAUCET_AUTHORITY=
# Public key only; faucet needs no SOL. Player pays network fees and own ATA rent.
# Dedicated worker authority only; never admin, hot-wallet or SOL-faucet. D153.290: the player pays the claim network fee.
# [owner] Public exclusions required by the worker; never derive these by opening other signer files.
# DEVNET_SKR_FAUCET_ADMIN_PUBKEY=
# DEVNET_SKR_FAUCET_SOL_FAUCET_PUBKEY=
# DEVNET_SKR_FAUCET_DEED_OPERATIONS_PUBKEY=
# HOT_WALLET_PUBKEY and all registry treasuries must also be supplied as public identities.

# --- Phase E variables night/server reads (added 2026-10-10) ------------------
# Tags: [pins file] = copy the value from chain/accepted/devnet/server-env.production.public,
# written by programs/night-devnet/pins.ts --identities accepted (public values only).
# [owner] = public value the owner decides and sets by hand. [owner secret] = the owner
# sets it by hand on the host and it names secret material; never commit or paste it.
# Every flag below stays dark; turn groups on only through the release runbook.

# Phase E KEEP identity (D153.272). [owner] disabled keeps legacy KEEP v3/Gems custody.
PHASE_E_KEEP_IDENTITY=disabled
# [owner] keep-v4 RESERVE public key; boot accepts only the reviewed named key, on devnet.
PHASE_E_KEEP_RESERVE_OWNER=

# Ordered mining claims through a frozen lookup table; needs the MINING_CLAIM_* pins above.
MINING_CLAIM_ORDERED_ENABLED=false
# [owner] Public lookup-table address and the sha256 of its reviewed account data.
MINING_CLAIM_LOOKUP_TABLE=
MINING_CLAIM_LOOKUP_TABLE_SHA256=

# Private mining publication: devnet tester stack only; needs keep-v4 and PHASE_E_SERVICE_DATABASE_URL.
MINING_PUBLICATION_TESTER_STACK=false
MINING_PUBLICATION_RECOVERY_ENABLED=false
MINING_PUBLICATION_JOB_ENABLED=false
# [owner] Public key only (never a key file); distinct from RESERVE, Gems reserve and hot wallet.
MINING_PUBLICATION_OPERATOR_PUBKEY=

# Seeker auctions (SA-1). Unset/false registers no auction routes and starts no crank.
PHASE_E_SEEKER_AUCTION_ENABLED=false
# [pins file] The seven auction read pins (apps/api/src/seeker/auctionRuntime.ts): all or none.
# Set them only after infra/devnet.addresses.json carries skrMint/skrDecimals equal to SEEKER_AUCTION_MINT.
SEEKER_AUCTION_PROGRAM_ID=
SEEKER_AUCTION_DEPLOYMENT_SLOT=
SEEKER_AUCTION_PROGRAM_DATA_SHA256=
SEEKER_AUCTION_UPGRADE_AUTHORITY=
SEEKER_AUCTION_MINT=
SEEKER_AUCTION_PRIZE_OWNER=
SEEKER_AUCTION_STATE_PROVENANCE=
# [owner secret] Optional (K-night-08). SEEKER_AUCTION_RPC_URL moves every auction RPC use: reads,
# player relay, crank sends — endpoint must accept sendTransaction; blank = SOLANA_RPC_URL
SEEKER_AUCTION_RPC_URL=
# Server crank (worker only); needs CHARTER_POLICY_ISSUER_* and a worker key mount. Leave false
# while the owner opens rounds with seeker-term.ts.
SEEKER_AUCTION_CRANK_ENABLED=false
# [owner] Public key of the dedicated crank key (not the admin, hot-wallet or faucet key).
SEEKER_AUCTION_CRANK_PUBKEY=
# [owner secret] Absolute in-container path to the dedicated crank keypair (read-only worker mount).
SEEKER_AUCTION_CRANK_KEYPAIR_FILE=

# NEVER on production: deploy.sh refuses this file if any of these appears (QA chain lane only).
# PKW_DEVNET_TEST_PROFILE, PKW_DEVNET_TEST_ECONOMY_PROGRAM_ID, any PKW_DEVNET_TEST_*: TEST programs.
# DEVNET_SKR_FAUCET_DEEDLESS_OK: deedless faucet claims (D153.290); the API also refuses it at boot.
# LEAGUE_SEASON_TEST_POT_ENABLED (above) must stay false.
# The Charter policy issuer is a separate process with its own file: infra/charter-issuer.env.example.
