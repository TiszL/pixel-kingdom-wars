# --- API ---
DATABASE_URL=postgres://shardkeep:shardkeep@localhost:5433/shardkeep
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me-32-bytes-min-change-me!!
PORT=8787
WEB_ORIGIN=http://localhost:5173
# Repository root: infra/<cluster>.addresses.json and local key files are resolved from
# here. `pnpm dev` runs the API from apps/api, so this relative default points at the
# checkout root; set an absolute path when running the API from elsewhere.
REPO_ROOT=../..
# Local single-process run: apply pending migrations at boot. Production runs
# `pnpm --filter @shardkeep/api db:migrate` as its own deploy step and leaves this off.
RUN_MIGRATIONS_ON_BOOT=true

# --- Solana (devnet) ---
SOLANA_CLUSTER=devnet
# The public devnet endpoint works for local development (rate limited). A dedicated
# provider endpoint such as https://devnet.helius-rpc.com/?api-key=<key> is recommended.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Unset uses the primary above for the complete finalized mint-evidence path.
MINT_EVIDENCE_RPC_URL=
# Same-origin browser RPC; bounded HTTP/WS relay never exposes the provider key.
RPC_RELAY_ENABLED=true
# Optional on devnet. A mainnet-beta process requires this second economy RPC,
# a different hostname, and two distinct non-secret provider labels. Both RPCs
# must prove the selected cluster by genesis hash before the API opens the DB.
SOLANA_RPC_URL_2=
SOLANA_RPC_PROVIDER=
SOLANA_RPC_PROVIDER_2=
# READ-ONLY mainnet-beta endpoint, used ONLY to verify Seeker Genesis Tokens and
# .skr domains (both live on mainnet; the game economy stays on devnet above).
# Unset -> /seeker/link/* answers 503 and the client hides the LINK button.
# MUST be mainnet-beta: boot rejects a devnet/testnet/local host outright and
# then proves the cluster by its genesis hash, because a wrong chain here makes
# every SGT check silently meaningless (security review F8).
SOLANA_MAINNET_RPC_URL=
# SECOND, INDEPENDENT mainnet endpoint — a DIFFERENT provider (same hostname
# counts as one source). The badge is an anti-sybil claim read entirely from a
# third-party RPC, so with this set the two must AGREE before a badge is
# granted; a disagreement grants nothing and revokes nothing. Leaving it unset
# is supported: the API then reports every Seeker verdict as `unconfirmed`
# rather than implying certainty. STRONGLY ADVISED since 2026-08-08: a proven
# SGT now also grants closed-alpha entry (source 'seeker'), so a single lying
# endpoint would otherwise mint admissions, not just badges. Any second
# provider's free tier is fine.
SOLANA_MAINNET_RPC_URL_2=
# optional, for DAS discovery of Metaplex Core assets + webhooks; free tier:
# https://www.helius.dev (finalized Core account reads remain authoritative)
HELIUS_API_KEY=
# NOTE: the Seeker mainnet RPC is SOLANA_MAINNET_RPC_URL (above). MAINNET_RPC_URL
# and SEEKER_VERIFY_ENABLED were removed 2026-07-29 — nothing read them, and a
# footgun next to a cluster assertion is worse than no variable at all.

# Server keypair paths. Provision these locally under the reviewed operations
# runbook; the files are gitignored and are never created by normal app startup.
ADMIN_KEYPAIR_PATH=infra/keys/admin.keypair.json
# Guarded incident recovery only: JSON object of epoch decimal -> exact devnet
# post_root signature, e.g. {"123":"<base58-signature>"}. The worker fetches and
# validates the exact successful instruction before the normal outbox marks sent.
# Leave empty during normal operation.
EPOCH_ROOT_RECOVERY_SIGNATURES=
HOT_WALLET_KEYPAIR_PATH=infra/keys/hot-wallet.keypair.json
# Public API uses only this address; worker boot proves the mounted key matches.
# Derive without exposing the secret: solana-keygen pubkey $HOT_WALLET_KEYPAIR_PATH
HOT_WALLET_PUBKEY=
# Only implemented custody backend. Allowed on devnet; mainnet-beta refuses to
# boot until a reviewed HSM/enclave adapter is implemented rather than named.
WITHDRAWAL_POLICY_CUSTODY_BACKEND=file
# Worker-only operational cadence (milliseconds; instant payouts are due now).
WITHDRAWAL_PAYOUT_POLL_MS=10000
# Bounded self-heal for paid players whose deed mint was missed.
DEED_MINT_RECONCILE_POLL_MS=60000

# Public program/mint addresses are versioned in infra/devnet.addresses.json.
# Do not run the retired full devnet bootstrap against the current branded state.
# DEAD CONFIG — nothing reads KEEP_MINT (verified 2026-07-28 security review).
# The authoritative mint is infra/devnet.addresses.json -> keepMint. Do not wire
# code to this legacy key; delete it instead.
KEEP_MINT=
CORE_PROGRAM_ID=
DISTRIBUTOR_PROGRAM_ID=

# Privy server-side — NOT needed for the SIWS social-login flow (Phase 1). For a
# future optional server-side Privy token verification only. NEVER prefix VITE_
# (that would ship the secret in the public client bundle). Real values in .env.
PRIVY_APP_SECRET=

# --- Web ---
# Read from THIS file: apps/web/vite.config.ts sets envDir to the repo root. Only
# VITE_-prefixed keys are exposed to the browser — treat every one as public.
VITE_API_URL=http://localhost:8787
# WORLD-MAP GLOBE (docs/WORLDMAP-GLOBE-PLAN.md P3). Current production is ON.
# Set 0/false only for deliberate fallback testing; normal local work should match
# the shipped Pixel-Earth world flow.
VITE_FEATURE_GLOBE=1
# REAL EARTH LAND TILES (docs/EARTH-TILES-PLAN.md P2+). NESTED INSIDE
# VITE_FEATURE_GLOBE: with the globe off this does nothing at all. Current
# production is ON and draws every land cell as real territory:
# MAPCOLOR9 country fills, coastlines, international borders, a 1 px tile grid, and
# the fine mask held back to z1.2 (below that a cell is sub-pixel and the frame
# costs 7-17 ms on a phone). Same do-not-regress standing as the globe flag itself.
VITE_FEATURE_EARTH_TILES=1
# Also feeds Privy's config.solana.rpcs (App.tsx): without an RPC for the chain in
# use, embedded-wallet login dies with "No RPC configuration found for chain
# solana:devnet". Use the same-origin relay so browser builds contain no provider key.
VITE_SOLANA_RPC_URL=http://localhost:5173/api/rpc/solana/devnet
VITE_SOLANA_CLUSTER=devnet
# Mainnet builds have no checked-in placeholder addresses. Set all six public
# values from the reviewed infra/mainnet.addresses.json ceremony before build;
# devnet builds use the checked-in devnet registry and ignore these blanks.
VITE_CORE_PROGRAM_ID=
VITE_CORE_CONFIG_PDA=
VITE_KEEP_MINT=
VITE_TREASURY_LIQUIDITY=
VITE_TREASURY_DEV=
VITE_TREASURY_OPS=
# Embedded wallets (Privy): social/email login → Solana wallet. Client needs ONLY
# the public APP ID. Unset = social-login button hidden, wallet-only flow unchanged.
VITE_PRIVY_APP_ID=
# optional, only for allowed-origin/client setups
VITE_PRIVY_CLIENT_ID=

# background jobs (BullMQ): enable in exactly one api process
ENABLE_WORKERS=false
# Lost PKW-authenticator recovery starts dark; already-active holds remain
# confirmable/cancellable/completable when this is later closed.
TOTP_RECOVERY_ENABLED=false
# Token login is dark until the real Privy account acceptance passes.
SOCIAL_TOKEN_LOGIN_ENABLED=false
PRIVY_APP_ID=
# https://auth.privy.io/api/v1/apps/<app-id>/jwks.json
PRIVY_JWKS_URL=
# Gold Forge is live. Only the exact lowercase false disables its routes.
FORGE_ENABLED=true
# Fresh v1 Hero Altar recruitment stays off unless explicitly true. Historical GET/POST
# receipts remain available; ordinary legacy construction is unchanged.
# Enable with the reviewed 0126 migration and matching recovery-capable clients.
HERO_RECRUITMENT_ENABLED=false
# Additive exact wall-stroke receipt contract. Legacy batch placement remains unchanged.
WALL_BATCH_V1_ENABLED=false
# FREE ONBOARDING (docs/LAND-DEED-ONBOARDING-PLAN.md P3). true = an
# ALPHA-ADMITTED player BUILDS FOR FREE: the starting base is created by their
# first authenticated GET /base, after the invite/Seeker gate passes, and the
# free route group (build / progress / look) drops the land gate. Buying
# land (0.2 SOL on-chain, unchanged) still mints the Land Deed and is what unlocks
# the Gold Forge, selling on the market, raiding landowners, PvE bounty raids and
# clans. A landless player gets NO parcel, so they are not on the world map at all.
# Production's intended closed-alpha flow uses true. The code default remains false
# as a rollback switch; only the literals true/false are accepted (typos fail boot).
FREE_ONBOARDING=true
# Deed-native multi-base is permanently active after the one-way writer cutover.
# A ready database rejects false; use false only in explicit legacy/pre-cutover tests.
MULTI_BASE_ENABLED=true
# Enable only after the approved fantasy manifest is rehearsed and installed.
# Disabling new sales never disables recovery of existing fantasy payments.
FANTASY_WORLD_ENABLED=false
# D-152 Gems (dark; E2-GEMS-CONTRACT §4). Children require GEMS_ENABLED=true.
GEMS_ENABLED=false
GEMS_WALLET_BUY_ENABLED=false
DEVNET_WELCOME_GEMS_ENABLED=false
# Required when wallet purchases are enabled. Startup proves and permanently
# pins the canonical Classic SPL KEEP ATA derived from this public authority.
# HOT_WALLET_PUBKEY is required to exclude custody; paid intent recovery is independent.
GEMS_RESERVE_OWNER=
# Optional equality cross-check, never used directly as a payment destination.
GEMS_RESERVE_ATA=
# D-152 §5 dark Phase E buildings and the Workshop refining routes
# (E2-WORKSHOP-CONTRACT §6). FORGE_INGOTS_ENABLED requires PHASE_E_BUILDINGS_ENABLED=true.
PHASE_E_BUILDINGS_ENABLED=false
# QA-only native construction art opt-in; production stays off.
# Requires PHASE_E_BUILDINGS_ENABLED=true and an admitted modern native renderer.
PHASE_E_ART_ENABLED=false
FORGE_INGOTS_ENABLED=false
# Ordinary raw/refined conversion starts; requires PHASE_E_BUILDINGS_ENABLED.
# Accepted automatic completion and original receipts survive a pause.
ORDINARY_CRAFTING_ENABLED=false
# Free starter installation (later departures): new admissions only; GET/replay survives pause.
# Requires PHASE_E_BUILDINGS_ENABLED=true and MULTI_BASE_ENABLED=true.
STARTER_EXPEDITIONS_ENABLED=false
# New explicit Harvester source selections only; accepted history/delivery survive pause.
# Requires PHASE_E_BUILDINGS_ENABLED=true and MULTI_BASE_ENABLED=true.
HARVESTERS_ENABLED=false
# Ranked rewards ship dark. Enable only before a complete Monday-to-Monday
# earning window begins; the first planned window starts 2026-09-07 UTC.
LEAGUE_REWARDS_ENABLED=false
# Monday UTC. If activation misses this window, advance to the next Monday;
# never enable late and backfill a partial earning week.
LEAGUE_REWARD_START_WEEK=2026-09-07
# Devnet only: show the labelled TEST weekly SKR season pot (packages/shared LEAGUE_SEASON_TEST_POT)
# on the read-only GET /leagues/season. Off by default; never set on mainnet. Not the owner's number.
LEAGUE_SEASON_TEST_POT_ENABLED=false
# The authored dark-attacker roster is enabled in the current SIM9 release.
DARK_ATTACKER_ROSTER_ENABLED=true
# In-game mail delivery is custody-bearing: true allows system/admin sends and
# reserves reward escrow. Reads/claims/expiry remain available while false.
# Keep false until migration 0083, PoR attribution, and the M22 forward-only
# rollback fence have all been verified.
MAIL_DELIVERY_ENABLED=false
# Admin KEEP attachments are disabled by default on mainnet. A reviewed
# community campaign must opt in with one public slug and a cumulative whole-
# KEEP ceiling; SHARDS, items, informational mail, claims, and expiry are
# governed separately by MAIL_DELIVERY_ENABLED.
MAINNET_COMMUNITY_KEEP_MAIL_ENABLED=false
MAINNET_COMMUNITY_KEEP_MAIL_CAMPAIGN_ID=
MAINNET_COMMUNITY_KEEP_MAIL_BUDGET=
# Hero gear combat is ON (D-059, owner 2026-08-16): equipped items change hero
# stats in raids. The old activation gate — the max-geared defensive Theodor
# 90-second counter-sim — is proven in packages/sim/tests/hero-gear.test.ts.
# Loadouts are frozen per raid, so historical replays stay byte-identical.
# Set false only as an emergency balance rollback (new raids revert to base
# stats; already-created raids keep their frozen loadouts).
HERO_GEAR_COMBAT_ENABLED=true
# (There is no PARCEL_CELLS setting. It existed until 2026-08-10, when no API
# response carried a cell or country, and was deleted because it gated nothing.
# The deed-map contract now deliberately carries the frozen earthCell in private
# viewer state, anonymous map markers and one authenticated/rate-limited parcel
# detail. That is stable land identity, not a metadata rollout. Its privacy boundary
# is route shape + land ownership + rate limiting; resurrecting the old no-op flag
# would still be a false rollback promise.)
# THE COUNTRY ON THE DEED (docs/EARTH-TILES-PLAN.md P6, owner decision Q3). true =
# a deed's metadata gains Country + Tile, both read from FROZEN columns — the cell
# from plots.earth_cell (migration 0053) and the country from plots.country_a3 +
# earth_countries (migration 0054) — never from the rebuildable Earth mask or country
# index, so regenerating the Earth data can never move a minted deed's stated country.
# This is the only Earth-tile switch the server has, and it is the one that matters:
# it publishes into a document a Metaplex asset points at, which cannot be
# un-published. Off restores the pre-P6 document byte for byte (the URI path is
# identical either way; only ?v= moves).
# This one-way document change is live in production. Keep true in ordinary local
# work; false is only meaningful against a pre-cutover fixture. Only the literals
# true/false are accepted (fails boot).
DEED_LOCATION_V2=true
# Liquidity-bootstrap gate (mainnet month 1): set false to disable ALL KEEP
# withdrawals while collected SOL seeds the pool; flip true at the liquidity
# event. Unset/true = withdrawals on (devnet + steady state).
WITHDRAWALS_ENABLED=true
# Land Deeds (Phase 6). Collection address lives in infra/devnet.addresses.json
# (created once via: pnpm --filter @shardkeep/scripts deed:collection).
# Dynamic per-wallet deed metadata: the api serves <base>/deed/<wallet>.json with
# LIVE base traits, and new deeds mint with that URI. Must be the api's PUBLIC
# host in prod — a localhost URI ends up on-chain and wallet UIs can't fetch it.
DEED_METADATA_BASE_URL=http://localhost:8787
# Static fallback used only when DEED_METADATA_BASE_URL is unset.
DEED_METADATA_URI=
# WHERE THE 5% DEED ROYALTY IS PAID (owner 2026-07-29). The RATE is a game
# number (MARKETPLACE.deedRoyaltyBps); the DESTINATION is an address, so it is
# config. SET THIS TO THE FINAL TREASURY BEFORE MAINNET. Empty = the admin
# signer (devnet status quo: the creator was whoever ran deed:collection).
#
# Setting it here does NOT move the money on its own — the collection is the
# on-chain source of truth and every deed mirrors it verbatim. One command
# repoints the live collection AND re-stamps every minted deed:
#   DEED_ROYALTY_CREATOR=<address> ADMIN_KEYPAIR_PATH=~/.config/solana/id.json \
#   pnpm --filter @shardkeep/scripts deed:royalty:creator --confirm
# (run without --confirm first: it prints old vs new and writes nothing)
# Until the sweep runs, the api REFUSES to mint new deeds whose collection
# creator disagrees with this value, instead of minting deeds that pay
# somewhere the config denies.
# Reminder: ruleSet is None, so this royalty is MARKETPLACE-HONOURED (Tensor /
# Magic Eden pay it by choice); a direct wallet-to-wallet transfer pays nothing.
DEED_ROYALTY_CREATOR=
# Cloudflare R2 — the PUBLIC metadata home while the api has no public host
# (owner 2026-07-26). All five set => new deeds mint with the bucket URI and a
# 60s reconciler keeps every deed/<wallet>.json matching live base state.
# Partial config = disabled. Create an R2 API token (Object Read & Write) in the
# Cloudflare dashboard; enable public access on the bucket (r2.dev or a domain).
# Fix pre-R2 deeds once with: pnpm --filter @shardkeep/scripts deed:reuri
# Deed metadata/base-image hosting AND public wallet avatars. WITHOUT the two
# key values, deed minting is DISABLED on purpose (jobs.ts) and authenticated
# avatar uploads answer 503. The two request paths have separate, exact object
# key guards (`deed/` and `avatar/`) even though they share this bucket.
# To turn deeds on: Cloudflare dashboard -> R2 -> Manage API tokens -> Create
# token (Object Read & Write, this bucket) -> paste the Access Key ID + Secret
# below -> restart the api. The sync loop then publishes
# <bucket>/deed/<wallet>.json and .png for every base and keeps them current.
# To repair deeds already minted against a dead host:
#   pnpm --filter @shardkeep/scripts deed:reuri
#
# ⚠ THESE MUST BE IN THE ENV FILE THE CONTAINER ACTUALLY READS, which is NOT
# this repo-root .env. The compose stacks load infra/.env.local (local /
# single-origin) or infra/.env.prod (production) via --env-file. Having them
# here and nowhere else is exactly how the sync silently died for five days on
# 2026-07-30: the vars looked present, the game looked fine, and every deed
# quietly froze at its last published state. The worker now warns on boot and
# every 30 min if it owns the schedulers but cannot see these.
# Check with:  docker exec shardkeep-worker-1 env | grep -c '^R2_'   (expect 5)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Land Deed ON-CHAIN URI sync (deedChainSync.ts). Wallets and explorers read a
# DAS indexer, not the deed's URI, and DAS only re-reads a document when
# something ON CHAIN changes — so without this a deed shows the traits DAS
# cached at mint, forever, however fresh the R2 document is.
#
# Costs SOL: one tx per ~6 deeds (measured), ~0.5 SOL/month at 20k players on
# the default 10-minute cadence. Signs with DEED_OPS_KEYPAIR_PATH when set
# (below); else falls back to ADMIN_KEYPAIR_PATH — which ALSO posts epoch roots
# and mints deeds — and says so loudly at boot. The loop refuses to run below
# 0.05 SOL so it can never starve those. Off by default; needs a signer key, a
# deedCollection in infra/devnet.addresses.json, and a public metadata host.
DEED_CHAIN_SYNC=false
# DEED-OPS delegate key — what the UNATTENDED loop above should hold instead of
# the admin key (dynamic deeds, owner GO 2026-08-03). It is an mpl-core
# COLLECTION-level UpdateDelegate: it can rewrite deed URIs/names and
# authority-managed plugins (and mint into the deed collection — an mpl-core
# given), but it CANNOT mint KEEP, post epoch roots, or touch the treasury —
# that is the point: a box running the sweep gets a key whose theft is an
# inconvenience, not a catastrophe. One-time setup (attended; admin signs once):
#   solana-keygen new -o infra/keys/deed-ops.keypair.json   # then fund it with SOL for fees
#   DEED_OPS_PUBKEY=<its pubkey> pnpm --filter @shardkeep/scripts deed:update-delegate --confirm
# (run without --confirm first: prints current vs proposed delegates, writes
# nothing; the script refuses a delegate equal to the admin key, and REPLACES
# the delegate list — rotation evicts the old key in the same write.)
# DEED_OPS_KEYPAIR_PATH: when set, the sweep signs (and pays fees) with this
# key. Unset = admin fallback, allowed but logged at every boot.
DEED_OPS_KEYPAIR_PATH=
# Read only by the attended deed:update-delegate script, never by the api.
DEED_OPS_PUBKEY=
# Allow the UNATTENDED chain sweep to re-point many deed URI origins/paths in
# one pass. Leave false: a content refresh only ever moves ?v=, so more than a
# handful of origin/path changes per pass means the public base moved or is
# misconfigured, and the sweep refuses the whole pass (circuit breaker,
# security-review follow-up #6). Bulk migrations belong to the attended
# deed:reuri script, which passes allowRepoint explicitly.
DEED_CHAIN_REURI=false
# --- Playtest access (owner 2026-09-07, D-118) ---
# Set true for public play. Keep ALPHA_WALLETS for internal-player analytics
# exclusions; opening access must not silently count team wallets as testers.
# Also retires new invite applications and issuance, preserving their history.
PLAYTEST_OPEN=false
# Gate: comma-separated base58 wallets always allowed. UNSET/blank = OPEN game.
# The effective allowlist is ALPHA_WALLETS ∪ ADMIN_WALLETS ∪ the alpha_access
# table (where POST /alpha/redeem invite redemptions land). Malformed fails boot.
ALPHA_WALLETS=
# Admin wallets for the /admin/alpha review panel (approve/reject applications,
# mint invite codes). UNSET = every /admin/alpha route answers 404 — the panel
# does not exist until this is configured. Admins pass the alpha gate implicitly.
ADMIN_WALLETS=
# Cloudflare Turnstile SERVER secret for the landing invite form
# (POST /alpha/apply). Unset = boot warns loudly and applications are accepted
# WITHOUT bot verification — dev only, set it in production.
TURNSTILE_SECRET_KEY=
# Resend (https://resend.com) transactional email. BOTH provide delivery for
# alpha invites + 2FA codes. Profile always exposes email enrollment, so a
# missing or partial production configuration fails boot. Development may leave
# both blank; challenge requests then fail instead of falsely returning sent.
# EMAIL_FROM must be a Resend-verified sender, e.g.
#   Pixel Kingdom Wars <invites@pixelkingdomwars.com>
RESEND_API_KEY=
EMAIL_FROM=
# Web Push notifications (M33, D-101): raided / build finished / training
# finished / mail received, sent by the worker sweep. OFF by default; when
# true ALL three VAPID values must be set or the api refuses to boot.
# generate once with npx web-push generate-vapid-keys; never rotate casually —
# rotating invalidates every stored subscription. VAPID_SUBJECT is a mailto:
# or https: contact the push services may use to reach you.
PUSH_NOTIFICATIONS_ENABLED=false
# Native data-only FCM (D-134), independently dark. No Firebase setup is needed
# until notification acceptance. Later mount the service-account JSON read-only,
# owner-readable only (0600); set its ABSOLUTE container path, never JSON here.
FCM_NOTIFICATIONS_ENABLED=false
FCM_SERVICE_ACCOUNT_FILE=
MINE_FULL_NOTIFICATIONS_ENABLED=false
# M34 authoritative 1x/2x clock. Keep false through migrations and 1x smoke;
# false blocks new V2 raids and 1x -> 2x, while existing V2 can resolve or slow.
LIVE_RAID_V2_ENABLED=false
# Selected-base raid SSE; enable together on API and worker after verification.
RAID_EVENTS_ENABLED=false
# Native client presentation remains OFF until worker load and physical-device acceptance.
NATIVE_PRESENTATION_ENABLED=false
# Optional on the ordinary API; required when the separate companion is enabled.
# Comma-separated tester public wallets. Empty must never publish the companion.
NATIVE_PRESENTATION_WALLETS=
# Ordinary API only. Enabling native presentation without a tester list refuses
# to boot unless this explicit public switch is true. Never set on the companion.
NATIVE_PRESENTATION_OPEN=false
# Set true ONLY for apps/api/src/native/server.ts, not the existing API/worker.
# The companion uses session/alpha config plus DB/Redis; no email/signing keys.
NATIVE_PRESENTATION_SERVICE=false
NATIVE_DB_POOL_MAX=2
NATIVE_PRESENTATION_WORKERS=1
NATIVE_PRESENTATION_MAX_RAIDS=8
NATIVE_PRESENTATION_MAX_STREAMS=16
NATIVE_PRESENTATION_CACHE_MIB=32
NATIVE_MIN_VERSION_CODE=0
NATIVE_CONTENT_MANIFEST_URL=
# Manifest for renderer contract < 15 (code 25) and web; empty = everyone gets the one above.
# Cutover: copy today's NATIVE_CONTENT_MANIFEST_URL here, then point the one above at the new pack.
NATIVE_CONTENT_MANIFEST_URL_LEGACY=
# Realm environment kit preview (docs/REALM-KIT-PLAN.md, D-173). Comma list of
# realm ids this host stamps at groundRevision 5 (e.g. crownlands) — QA only.
# Leave empty in production until the owner approves the pilot on both clients;
# an unknown realm id fails boot. Frozen raid contexts are never rewritten.
REALM_KIT_PREVIEW_REALMS=
# DEV/QA ONLY twin: the unpinned kit manifest(s) this host serves for the realms
# above, as <realmId>=atlas/fantasy/layered-ground/<sha256>/manifest.json (comma
# list; the file must exist under apps/web/public). Lets the deed renderer,
# expansion obstacles and the native client run the real revision-5 path before
# the catalogue pin exists. Refused when NODE_ENV=production.
REALM_KIT_PREVIEW_MANIFESTS=
# Web dev-only twin of the switch above (REALM-KIT-PLAN §6.3 local verification,
# REALM-THEMES-PLAN §3 P0): a comma map of <realmId>=<manifest url>, one unpinned
# kit manifest per realm under review, each served under /atlas/, e.g.
# crownlands=/atlas/fantasy/layered-ground/<sha256>/manifest.json, preview-only
# status allowed. Only the realms named route through it (a manifest built for
# another realm is refused); every other realm keeps its catalogue pin. A malformed
# entry throws by name. Vite replaces import.meta.env.DEV with false in production,
# so the map is always empty and the value is inert there (the unreachable preview
# path still ships in the lazy Phaser chunk; it is not tree-shaken) — leave it empty
# unless you are checking a local kit.
VITE_REALM_KIT_PREVIEW_MANIFESTS=
# M45 in-app update channel: dark by default. When true the API advertises channel rows
# from native_update_channel; APK bytes are served by Caddy from R2, never by the API.
NATIVE_UPDATE_CHANNEL_ENABLED=false
# Kill switch for the native new world (globe + realm maps bundled in the APK), default on.
# Set false to send every native client back to the legacy globe on its next capabilities
# read; only the api container needs recreating (docs/NATIVE_PRODUCTION.md).
NATIVE_WORLD_V2_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Dedicated 2FA root keyring. First key writes; remaining keys decrypt/verify
# during rotation. Never reuse JWT_SECRET. Generate each value with:
#   openssl rand -base64 32
# Format: key-id:base64-key[,older-key-id:base64-key]
TWOFA_ENCRYPTION_KEYS=

# dev-only signature-less login (NEVER enable in production)
DEV_LOGIN=false
# Dev realm switch (REALM-THEMES-PLAN §3 P0): the realm the dev-login base presents
# — GET /base visualContext, kit obstacles, deed render, native content — so a realm
# kit is reviewed under a real base. A fresh dev base is seeded there; an already-
# seated one keeps its fantasy claim (assigned claims are immutable) and only its
# presentation follows; the globe keeps the persisted tile. Every dev-login under
# the switch re-seats the kit obstacle rows. One of the realm ids (crownlands,
# frostveil, elderwood, sunscar, seeker-reach, stormcairn, thornwake, cinderfall);
# a misspelling fails boot; refused in production. A value REQUIRES DEV_LOGIN=true
# (boot refuses it otherwise). The fantasy world is optional: with it on, a fresh dev
# base is seeded in the realm; with it off (the local review host), a base that has
# no fantasy address presents the realm — the owner's legacy dev base included.
DEV_LOGIN_REALM=

# MUST be production on any deployed box. Never set DEV_LOGIN=true in production —
# dev-login issues a signature-less session for any wallet. Fail-closes to production if unset.
NODE_ENV=development
# LOCAL ART APPROVAL ONLY. Absolute path to the fixed three-PNG provider proof
# candidate. Leave empty normally; the rasterizer refuses a value in CI or when
# NODE_ENV=production, and the web production build rejects candidate metadata.
# VITE_PKW_CANDIDATE_ORIGIN is set only by scripts/candidate/build-web.mjs for the
# isolated candidate web build; never set it here or in production (deploy.sh refuses it).
SHARDKEEP_ART_CANDIDATE_ROOT=
# ART PIPELINE IMPLEMENTATION FLAGS. The root `pnpm assets` command sets both
# explicitly and emits the hash-reviewed strict game-v4 release atlas. Do not
# add them to a runtime/production env file. A direct rasterizer invocation may
# set only the first flag for local review; CI/production refuses that mode
# unless the release opt-in is also explicit. Bytes only: cell size, grid,
# anchor, fps and row order stay with the manifest, and a wrongly-sized sheet
# fails the build.
SHARDKEEP_GAME_V4_OVERLAY=
SHARDKEEP_GAME_V4_OVERLAY_ALLOW_RELEASE=

# --- backup rehearsal (host scripts only; the API does not read these) ------
# Local/devnet may explicitly keep backups local for a disposable rehearsal.
# Mainnet/mainnet-beta always rejects that opt-out. Production should instead
# use BACKUP_OFFSITE_REQUIRED=true and BACKUP_VERIFY_SOURCE=remote, with a
# gitignored rclone config dedicated to an immutable/off-host backup bucket.
BACKUP_NETWORK=local
BACKUP_OFFSITE_REQUIRED=false
BACKUP_VERIFY_SOURCE=local
BACKUP_DIR=/tmp/shardkeep-backups
BACKUP_KEEP_LOCAL_HOURS=48
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_CONFIG=

# Payout solvency brake. PoR counts only the finalized canonical KEEP ATA owned
# by HOT_WALLET_PUBKEY after validating its token program, mint, authority,
# initialized/unfrozen state, and lack of delegate. LP positions, generic
# treasuries and arbitrary owner lists never count as withdrawable custody.
# Emergency escape hatch: 'true' disables the solvency brake entirely. The gate
# fails closed on missing/ineligible custody evidence and RPC failure, so an
# account-configuration error or long RPC outage otherwise holds all payouts.
# Logs loudly on every payout while set. Unset it as soon as the reader is right.
PAYOUT_COVERAGE_OVERRIDE=

# Marketing-site origins allowed to reach ONLY POST /alpha/apply, WITHOUT
# credentials (scoped CORS — security review 2026-08-05). Never put the landing
# site into WEB_ORIGIN: that is the credentialed allowlist for the whole api.
LANDING_ORIGINS=https://pixelkingdomwars.com,https://www.pixelkingdomwars.com
# Where invite emails send approved players. Falls back to WEB_ORIGIN[0].
# Also the `$pageview` address the analytics relay files app opens under.
PLAY_URL=https://play.pixelkingdomwars.com

# --- Analytics relays (M23 a13) — ALL optional, dark by default -------------
# PostHog product events (funnels/retention dashboards). Identity is a
# pseudonymous HMAC of the wallet; raw wallets never leave the server.
POSTHOG_API_KEY=
# Defaults to https://us.i.posthog.com when unset.
POSTHOG_HOST=
# Sentry DSN — client errors relayed through /telemetry (release pkw-web@<sha7>)
# plus the API's own 500s and failed worker jobs (release pkw-api@<sha7>).
# Conventions and the post-deploy canary: docs/ANALYTICS.md.
SENTRY_DSN=
# KEEP_VEND_ENABLED — treasury buy-KEEP vend. Default false (fail-closed,
# # ONRAMP-WALLETS-PLAN); devnet prod runs true (owner 2026-08-16). Gates NEW
# # intents only — a paid historical intent always credits.
KEEP_VEND_ENABLED=false

# --- DEVNET PLAYTEST ONLY: in-game devnet SOL faucet (owner 2026-08-22) ---
# The API records grant requests; the WORKER pays them from the dedicated
# faucet keypair below (never the hot wallet, never the admin key). Eligibility,
# grant size and caps live in packages/shared/src/constants.ts DEVNET_FAUCET.
# Config refuses DEVNET_FAUCET_ENABLED=true on any cluster but devnet. Remove
# this block, money/devnetFaucet.ts and routes-devnet-faucet.ts before mainnet.
DEVNET_FAUCET_ENABLED=false
# Generate once: pnpm --filter @shardkeep/api devnet-faucet:init (prints the
# address to fund with devnet SOL). Worker-only mount in production.
DEVNET_FAUCET_KEYPAIR_PATH=infra/keys/devnet-faucet.keypair.json

# --- Founding Kingdoms playtest window (D-103) ------------------------------
# Optional ISO-8601 start of the 14-day playtest window (PLAYTEST_CAMPAIGN).
# Unset = no window: the site and game say the playtest is live without a day
# counter. Presentation only; points and public statistics never depend on it.
CAMPAIGN_START_AT=

# Private feedback screenshots — a SEPARATE PRIVATE R2 bucket and bucket-scoped
# Object Read & Write credential. No public r2.dev/custom domain. Never reuse
# R2_BUCKET (public deed/avatar data). All absent disables uploads; partial or
# invalid config must fail closed. Install only in server API/worker secrets.
FEEDBACK_R2_ACCOUNT_ID=
FEEDBACK_R2_BUCKET=
FEEDBACK_R2_ACCESS_KEY_ID=
FEEDBACK_R2_SECRET_ACCESS_KEY=

# Staged fantasy globe client; enable only alongside compatible world API.
VITE_FEATURE_FANTASY_WORLD=0
# World v2 (D-186): flat globe + realm maps as lazy chunks inside the fantasy world.
# Requires VITE_FEATURE_FANTASY_WORLD=1. Off (0) = no world chunk is built and the CPU
# globe stays; at runtime an explicit worldV2.enabled=false from /api/native/capabilities
# (NATIVE_WORLD_V2_ENABLED, shared with native) also keeps the CPU globe.
VITE_FEATURE_WORLD_V2=0

# Native versioned SOL base-purchase quotes. History/reconciliation remain available when paused.
BASE_PURCHASE_V1_ENABLED=false
# Native ordinary/Warzone shield quotes additionally require the base purchase gate.
SHIELD_PURCHASE_V1_ENABLED=false

# Exact transferred-deed claim commands; history and explicit cancellation remain available while paused.
BASE_CLAIM_V1_ENABLED=false

# Native ABI3/7 energy quotes; also requires BASE_PURCHASE_V1_ENABLED=true.
# Keep false until migration0131 and compatible API/worker are verified. Historical recovery remains available.
ENERGY_PURCHASE_V1_ENABLED=false

# --- Phase E catalogue gate (WORKING-RULES S4) ---------------------------
PHASE_E_CATALOG_ENABLED=false
PHASE_E_MINING_ENABLED=false
# Private runtime; reviewed mount patches and real source assembly required.
# Recovery never signs. The job prepares only with a reachable authorized publisher.
MINING_PUBLICATION_TESTER_STACK=false
MINING_PUBLICATION_RECOVERY_ENABLED=false
MINING_PUBLICATION_JOB_ENABLED=false
# Public OPERATOR identity only: AvsebCwRDs63UMwKv2xSVCRKB8cxUS4W3B4sNR9SHpKv
# No private key or key path belongs in this configuration.
MINING_PUBLICATION_OPERATOR_PUBKEY=
PHASE_E_SEEKER_ENABLED=false
PHASE_E_VEHICLES_ENABLED=false
PHASE_E_CHARTER_ENABLED=false

# D153.331: separate Phase E KEEP identity, never a v3 alias.
# keep-v4 requires devnet, actual infra/devnet.addresses.json.keepMintV4,
# reviewed ceremony/deployment evidence and the matching immutable Phase E row.
# Admitted runtime integration must refuse missing/mismatched selection at startup.
# This producer helper alone enables nothing; KEEP_MINT is not an override.
PHASE_E_KEEP_IDENTITY=disabled
# Public RESERVE owner only; required when keep-v4 is selected. Leave blank now.
# Accepted owner: CVKo5i8ax2kiKe9nSB4LfCpBEbyfaLcq8S8bWXsvKo1Q
PHASE_E_KEEP_RESERVE_OWNER=
# No PHASE_E_*GEMS_RESERVE* config or v4 gemsReserveOwner/gemsReserveAta fields:
# their presence (even blank) refuses keep-v4. Legacy GEMS_RESERVE_* stays v3.
# New custodial Gems purchase KEEP sink is TREASURY's keepMintV4 ATA, a separate
# reviewed purchase-path cutover; it is not mining recovery trust or activation.

# Phase E D153.190: KEEP equipment listing/purchase admission; default off.
KEEP_EQUIPMENT_MARKET_ENABLED=false

# Phase E public mining PoR: leave all pins blank until separately admitted.
# Read-only disclosure; does not enable publication, claims or custodial backing.
# Hash covers the ENTIRE reviewed ProgramData account (metadata included).
MINING_TRANSPARENCY_PROGRAM_ID=
MINING_TRANSPARENCY_DEPLOYMENT_SLOT=
MINING_TRANSPARENCY_PROGRAM_DATA_SHA256=
# Separate reviewed claim quote/same-wire relay identity; PoR does not enable sends.
# Blank keeps live claim sources absent; original database recovery remains available.
MINING_CLAIM_PROGRAM_ID=
MINING_CLAIM_DEPLOYMENT_SLOT=
MINING_CLAIM_PROGRAM_DATA_SHA256=
# Optional ordered v0 claims stay disabled until independent frozen ALT review.
MINING_CLAIM_ORDERED_ENABLED=false
MINING_CLAIM_LOOKUP_TABLE=
MINING_CLAIM_LOOKUP_TABLE_SHA256=

# Complete independent realm-sale quote/same-wire relay policy; leave all blank until reviewed.
# Auction mint/prize owner are Seeker auction identities, not KEEP reserve identities.
# UPGRADE_AUTHORITY is the reviewed key or explicit none; ROUND is exact unsigned decimal.
# STATE_PROVENANCE must be the explicit attestation fresh-reviewed-deployment.
SEEKER_REALM_SALE_PROGRAM_ID=
SEEKER_REALM_SALE_DEPLOYMENT_SLOT=
SEEKER_REALM_SALE_PROGRAM_DATA_SHA256=
SEEKER_REALM_SALE_UPGRADE_AUTHORITY=
SEEKER_REALM_SALE_AUCTION_MINT=
SEEKER_REALM_SALE_PRIZE_OWNER=
SEEKER_REALM_SALE_DEVELOPER=
SEEKER_REALM_SALE_ROUND=
SEEKER_REALM_SALE_POLICY_REVISION=
SEEKER_REALM_SALE_STATE_PROVENANCE=

# NIGHT DEVNET TEST PROFILE ONLY (packages/chain/src/devnetTestProfile.ts). Both stay unset by
# default and are NEVER set on production; on QA only via the candidate chainLane knob.
# Only when PKW_DEVNET_TEST_PROFILE equals
# PHASE_E_DEVNET_TEST.profile (packages/shared/src/constants.ts), SOLANA_CLUSTER is written out
# as devnet, and PKW_DEVNET_TEST_ECONOMY_PROGRAM_ID names one fresh test economy program, that one
# id passes the realm-sale identity pins and reads the shorter test auction calendar. The accepted
# economy id keeps its own identity and auction length whatever these say; the term never changes.
# A malformed or accepted program id here makes every check of a non-accepted id refuse loudly.
# PKW_DEVNET_TEST_PROFILE=
# PKW_DEVNET_TEST_ECONOMY_PROGRAM_ID=

# Private Phase E services: same DB, separate owner LOGIN; leave unset until admitted.
# Never reuse DATABASE_URL or give the request role private journal access.
# Recovery remains mounted while admission flags are paused. No issuer/chain authority implied.
PHASE_E_SERVICE_DATABASE_URL=

# Optional historical KEEP tax quote/relay policy, independent from claims and realm sales.
# Set every field together after review; reserve/mint use the selected economy binding.
# UPGRADE_AUTHORITY is the reviewed key or literal none (revoked). Auction mint is independent of KEEP.
# STATE_PROVENANCE must explicitly be fresh-reviewed-deployment. Round is verified from the original claim.
MINING_TAX_PROGRAM_ID=
MINING_TAX_DEPLOYMENT_SLOT=
MINING_TAX_PROGRAM_DATA_SHA256=
MINING_TAX_UPGRADE_AUTHORITY=
MINING_TAX_AUCTION_MINT=
MINING_TAX_PRIZE_OWNER=
MINING_TAX_STATE_PROVENANCE=

# Optional reviewed Metaplex Core source for vehicle installation/service/recovery.
# All three required together; explicit upgrade authority key or 'none'.
# Does not admit acquired mint provenance or activate any Phase E feature.
VEHICLE_CORE_DEPLOYMENT_SLOT=
VEHICLE_CORE_PROGRAM_DATA_SHA256=
VEHICLE_CORE_UPGRADE_AUTHORITY=

# Phase E read-only Charter original recovery. All blank disables chain reads.
# Explicit reviewed pins never grant permit issuance, new funding or delivery.
CHARTER_RECOVERY_ECONOMY_PROGRAM_ID=
CHARTER_RECOVERY_ECONOMY_DEPLOYMENT_SLOT=
CHARTER_RECOVERY_ECONOMY_PROGRAM_DATA_SHA256=
CHARTER_RECOVERY_ECONOMY_UPGRADE_AUTHORITY=
CHARTER_RECOVERY_CRAFT_PROGRAM_ID=
CHARTER_RECOVERY_CRAFT_DEPLOYMENT_SLOT=
CHARTER_RECOVERY_CRAFT_PROGRAM_DATA_SHA256=
CHARTER_RECOVERY_CRAFT_UPGRADE_AUTHORITY=
CHARTER_RECOVERY_CORE_DEPLOYMENT_SLOT=
CHARTER_RECOVERY_CORE_PROGRAM_DATA_SHA256=
CHARTER_RECOVERY_CORE_UPGRADE_AUTHORITY=
CHARTER_RECOVERY_STATE_PROVENANCE=

# Explicit operator sponsor; no event is funded by mounting this service.
# Requires complete MINING_CLAIM trust. New fragment earnings also need Seeker trust.
DIVINE_TRIAL_SPONSOR_WALLET=

# KEEP market payment sources: complete reviewed limits plus SOLANA_RPC_URL_2 and
# distinct SOLANA_RPC_PROVIDER / SOLANA_RPC_PROVIDER_2 labels. No default spending cap.
# Optional separate broadcast endpoint relays only the player's retained original wire.
KEEP_MARKET_MIN_CONTEXT_SLOT=
KEEP_MARKET_TRANSACTION_VERSION=
KEEP_MARKET_MAX_FEE_LAMPORTS=
KEEP_MARKET_MAX_PRIORITY_FEE_LAMPORTS=
KEEP_MARKET_MAX_COMPUTE_UNIT_LIMIT=
KEEP_MARKET_BROADCAST_RPC_URL=

# Independent clan-event funding identity. Requires complete Charter recovery and
# Seeker policy groups; never initializes an epoch or funds during startup.
# Independent API client to the dedicated Charter issuer. Never a raw private key.
# Issuer-only permits saved original lookup; current actions need the entire next group.
CHARTER_POLICY_ISSUER_URL=
CHARTER_POLICY_ISSUER_PUBLIC_KEY=
CHARTER_POLICY_ISSUER_AUTH_TOKEN_FILE=
CHARTER_POLICY_ISSUER_ALLOW_PRIVATE_HTTP=false
# Explicit full current Charter authority; requires reviewed CHARTER_RECOVERY pins.
# Cost profile is an operator attestation tied to those exact reviewed Core bytes.
CHARTER_WORKFLOW_METADATA_URI_PREFIX=
CHARTER_WORKFLOW_SALE_TREASURY=
CHARTER_WORKFLOW_LOOKUP_TABLE_ADDRESS=
CHARTER_WORKFLOW_LOOKUP_TABLE_SHA256=
CHARTER_WORKFLOW_CORE_COST_PROFILE=
CHARTER_WORKFLOW_MAX_NETWORK_FEE_LAMPORTS=
CHARTER_WORKFLOW_MAX_RENT_LAMPORTS=
CHARTER_WORKFLOW_MAX_TOTAL_LAMPORTS=
CHARTER_WORKFLOW_MAX_ADDITIONAL_LAMPORTS=
# Optional separate exact-original-wire relay. Blank does not send.
CHARTER_WORKFLOW_RELAY_RPC_URL=
CHARTER_TOURNAMENT_SPONSOR_WALLET=
CHARTER_TOURNAMENT_TREASURY=

# SA-1 Seeker spot auctions: remain dark until complete reviewed pins are provisioned.
PHASE_E_SEEKER_AUCTION_ENABLED=false
SEEKER_AUCTION_CRANK_ENABLED=false
SEEKER_AUCTION_PROGRAM_ID=
SEEKER_AUCTION_DEPLOYMENT_SLOT=
SEEKER_AUCTION_PROGRAM_DATA_SHA256=
SEEKER_AUCTION_UPGRADE_AUTHORITY=
SEEKER_AUCTION_MINT=
SEEKER_AUCTION_PRIZE_OWNER=
SEEKER_AUCTION_STATE_PROVENANCE=
# Optional (K-night-08): RPC for the Seeker auction runtime.source. Unset uses SOLANA_RPC_URL.
# Setting it moves EVERY auction RPC use of that source, not only reads: the finalized reads
# and quotes, the player relay (auctionRoutes.ts:143 sendRawTransaction) and the crank's reads
# and signed sends (auctionCrank.ts:301), so the endpoint must accept sendTransaction. Set a
# single-node, bank-exact endpoint here if the primary is a multi-node pool whose finalized
# answers keep moving or mislabel their slot.
SEEKER_AUCTION_RPC_URL=
SEEKER_AUCTION_CRANK_PUBKEY=
# Absolute worker-only file path; never paste a key or commit a keypair.
SEEKER_AUCTION_CRANK_KEYPAIR_FILE=
# Dedicated issuer process only. Public pins, independent default-off capability.
CHARTER_ISSUER_SEEKER_AUCTION_ENABLED=false
CHARTER_ISSUER_SEEKER_AUCTION_MINT=
CHARTER_ISSUER_SEEKER_AUCTION_PRIZE_OWNER=
CHARTER_ISSUER_SEEKER_AUCTION_CRANK_PUBKEY=
# CLI integration resolves the reviewed public registry from this absolute root.
CHARTER_ISSUER_REGISTRY_ROOT=
# Phase E web presentation stays hidden independently of server/native QA flags.
# Keep 0 until the new web interface and its parity gates are accepted; then rebuild.
VITE_PHASE_E_WEB_ENABLED=0

# DEVNET ONLY (D153.275): leave every DEVNET_SKR_FAUCET_* unset on mainnet-beta; boot refuses any presence.
# DEVNET_SKR_FAUCET_ENABLED=false
# DEVNET_SKR_FAUCET_KEYPAIR_PATH=/run/secrets/devnet-skr-faucet.json
# DEVNET_SKR_FAUCET_AUTHORITY=
# Public key only; faucet needs no SOL. Player pays network fees and own ATA rent.
# Dedicated worker authority only; never admin, hot-wallet or SOL-faucet. D153.290: the player pays the claim network fee.
# Public exclusions required by the worker; never derive these by opening other signer files.
# DEVNET_SKR_FAUCET_ADMIN_PUBKEY=
# DEVNET_SKR_FAUCET_SOL_FAUCET_PUBKEY=
# DEVNET_SKR_FAUCET_DEED_OPERATIONS_PUBKEY=
# HOT_WALLET_PUBKEY and all registry treasuries must also be supplied as public identities.
# QA chain lane ONLY (owner N-045): true lets a deedless base claim. Boot refuses it under NODE_ENV=production;
# leave unset everywhere else (D153.290: a deedless player cannot claim).
# DEVNET_SKR_FAUCET_DEEDLESS_OK=
