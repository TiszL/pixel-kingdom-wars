{
  "name": "@shardkeep/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrateCli.ts",
    "divine:operator": "tsx src/game/divineOperatorCli.ts",
    "divine:clan-operator": "tsx src/game/clanDivineOperatorCli.ts",
    "charter:sale-operator": "tsx src/game/charterSaleOperatorCli.ts",
    "native:update-channel": "tsx src/native/updateChannelCli.ts",
    "releases": "tsx src/releases/cli.ts",
    "db:reseed-camps": "tsx --env-file=../../.env src/db/reseedCamps.ts",
    "db:maxed-camp": "tsx --env-file=../../.env src/db/spawnMaxedCamp.ts",
    "db:rename-valleys": "tsx --env-file=../../.env src/db/renameValleys.ts",
    "db:rewrap-twofa": "tsx --env-file=../../.env src/db/rewrapTwofa.ts",
    "devnet-faucet:init": "tsx --env-file=../../.env src/devnetFaucetInit.ts",
    "db:purge-ghost-players": "tsx --env-file=../../.env src/db/purgeGhostPlayers.ts",
    "db:purge-synthetic-accounts": "tsx --env-file=../../.env src/db/purgeSyntheticAccounts.ts",
    "db:backfill-welcome-keep": "tsx --env-file=../../.env src/db/backfillWelcomeKeep.ts",
    "charter-issuer": "tsx src/charterPolicyIssuerServer.ts",
    "charter-issuer:init": "tsx src/charterPolicyIssuerInit.ts initialize",
    "policy-signer": "tsx src/policySignerServer.ts",
    "policy-signer:init": "tsx src/policySignerInit.ts",
    "policy-signer:verify": "tsx src/policySignerVerify.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "11.3.0",
    "@noble/ed25519": "^3.1.0",
    "@shardkeep/chain": "workspace:*",
    "@shardkeep/shared": "workspace:*",
    "@shardkeep/sim": "workspace:*",
    "@solana/web3.js": "1.98.4",
    "aws4fetch": "^1.0.20",
    "bs58": "^6.0.0",
    "bullmq": "^5.78.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "firebase-admin": "14.4.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.3",
    "otpauth": "^9.5.1",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "sharp": "0.35.1",
    "tsx": "^4.22.4",
    "web-push": "^3.6.7",
    "ws": "8.21.0",
    "yazl": "3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@solana/kit": "5.5.1",
    "@solana/spl-token": "0.4.14",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@types/ws": "8.18.1",
    "@types/yazl": "3.3.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
