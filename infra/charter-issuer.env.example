# Dedicated process only. All empty required fields hold startup; no live defaults.
# See docs/phase-e/CHARTER-ISSUER-RUNTIME.md. Never reuse withdrawal/API private keys.
CHARTER_ISSUER_CLUSTER=
CHARTER_ISSUER_READ_RPC_URL=
CHARTER_ISSUER_CURRENT_PUBLIC_KEY=
CHARTER_ISSUER_SECRET_KEY_FILE=
CHARTER_ISSUER_AUTH_TOKEN_FILE=
CHARTER_ISSUER_JOURNAL_FILE=
CHARTER_ISSUER_STATE_PROVENANCE=
CHARTER_ISSUER_ECONOMY_PROGRAM_ID=
CHARTER_ISSUER_ECONOMY_DEPLOYMENT_SLOT=
CHARTER_ISSUER_ECONOMY_PROGRAM_DATA_SHA256=
CHARTER_ISSUER_ECONOMY_UPGRADE_AUTHORITY=
CHARTER_ISSUER_CRAFT_PROGRAM_ID=
CHARTER_ISSUER_CRAFT_DEPLOYMENT_SLOT=
CHARTER_ISSUER_CRAFT_PROGRAM_DATA_SHA256=
CHARTER_ISSUER_CRAFT_UPGRADE_AUTHORITY=
CHARTER_ISSUER_CORE_PROGRAM_ID=
CHARTER_ISSUER_CORE_DEPLOYMENT_SLOT=
CHARTER_ISSUER_CORE_PROGRAM_DATA_SHA256=
CHARTER_ISSUER_CORE_UPGRADE_AUTHORITY=
CHARTER_ISSUER_HOST=127.0.0.1
CHARTER_ISSUER_PORT=3004
CHARTER_ISSUER_ALLOW_PRIVATE_HTTP=false
# Seeker auction crank permits (added 2026-10-10). false keeps the issuer charter-only.
CHARTER_ISSUER_SEEKER_AUCTION_ENABLED=false
# Absolute repo root whose infra/devnet.addresses.json (mainnet.addresses.json) has skrMint/skrDecimals.
CHARTER_ISSUER_REGISTRY_ROOT=
# Same public values as the API's SEEKER_AUCTION_MINT / _PRIZE_OWNER / _CRANK_PUBKEY (pins file + owner).
CHARTER_ISSUER_SEEKER_AUCTION_MINT=
CHARTER_ISSUER_SEEKER_AUCTION_PRIZE_OWNER=
CHARTER_ISSUER_SEEKER_AUCTION_CRANK_PUBKEY=
