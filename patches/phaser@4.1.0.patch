diff --git a/dist/phaser.esm.js b/dist/phaser.esm.js
index bb71b9c77475aa99f9f0d0532e36aa3018ddc897..028b46dac8906d9e61bc1e6482357152c24fccff 100644
--- a/dist/phaser.esm.js
+++ b/dist/phaser.esm.js
@@ -19009,7 +19009,9 @@ var TimeStep = new Class({
 
         if (this.delta >= this._limitRate)
         {
-            this.callback(time, this.delta);
+            // The remainder stays queued below; delivering it here as well
+            // counts the same elapsed time again on the next limited step.
+            this.callback(time, this.delta - (this.delta % this._limitRate));
 
             this.delta %= this._limitRate;
         }
@@ -204569,6 +204571,12 @@ module.exports = [
     '{',
     '    vec2 layerTexCoord = outTexCoord;',
     '    Tile tile = getLayerData(layerTexCoord);',
+    '    /* An empty tile has no tileset texel: getTileTexelCoord answers (0, 0), which */',
+    '    /* samples the sheet corner (its bottom-left pixel under flipY and REPEAT wrap). */',
+    '    if (tile.empty)',
+    '    {',
+    '        discard;',
+    '    }',
     '    Samples samples = getFinalSamples(tile, layerTexCoord);',
     '    vec4 fragColor = samples.color;',
     '    #pragma phaserTemplate(declareSamples)',
@@ -242623,7 +242631,17 @@ var Tileset = new Class({
                 var animationDuration = tileDatum.animationDuration;
 
                 // This index maps to an animation, not a single tile.
-                indexToAnimMap.set(i, animations.length);
+                // The layer data texture stores this value and the shader reads it as a
+
+                // texel index (duration at n, frame offset at n + 1). Animation records
+
+                // are two texels wide, so the n-th animation lives at texel 2n; the bare
+
+                // ordinal resolves every animation after the first to another record's
+
+                // frame offset.
+
+                indexToAnimMap.set(i, animations.length * 2);
 
                 // This animation points to a run of frames.
                 animations.push([ animationDuration, animFrames.length ]);
