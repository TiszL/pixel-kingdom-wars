{
  "name": "@shardkeep/web",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/verify-versioned-html.mjs && node scripts/size-check.mjs && node scripts/emit-version.mjs && node scripts/emit-asset-pack.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests && node --test --test-reporter=spec 'src/ui/fantasy/worldv2/**/*.test.mjs'",
    "size-check": "node scripts/size-check.mjs"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
