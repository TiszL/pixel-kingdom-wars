{
	admin off
	auto_https off
	persist_config off
}
:8080 {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		Cache-Control "public, max-age=31536000, immutable"
	}
	# Only verified immutable generations are placed beneath this dedicated mount.
	handle_path /native-content/* {
		root * /srv/content
		file_server
	}
	respond 404
}
